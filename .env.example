# Motore AI: anthropic (Claude, default), openrouter, gemini, azure, llamacpp.
# Puoi indicarne più di uno separati da virgola: se il primo fallisce si passa al successivo (es. azure,gemini)
AI_PROVIDER=anthropic

# --- Google Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=
# Modelli separati da virgola, provati in ordine
# GEMINI_MODEL=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash

# --- Azure OpenAI (portale Azure → risorsa OpenAI → Chiavi ed endpoint)
# AZURE_OPENAI_ENDPOINT=https://NOME-RISORSA.openai.azure.com
# AZURE_OPENAI_API_KEY=
# Nome del deployment (non del modello); più deployment separati da virgola
# AZURE_OPENAI_DEPLOYMENT=

# --- OpenRouter (https://openrouter.ai/keys): modelli ospitati, anche gratuiti
# OPENROUTER_API_KEY=sk-or-...
# Modelli con "structured outputs" (i gratuiti finiscono con :free), separati da virgola:
# provati in ordine, se uno fallisce si passa al successivo
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-super-vl:free

# --- Claude: chiave API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- llama.cpp: indirizzo di llama-server (API compatibile OpenAI)
# LLAMACPP_URL=http://192.168.1.50:8080
# Tempo massimo per una singola risposta del modello locale, in minuti
# LLAMACPP_TIMEOUT_MIN=30

# Registrazione aperta: il primo utente può sempre registrarsi.
# Metti true per creare gli altri account (es. tua moglie), poi rimetti false.
ALLOW_SIGNUP=false

# true se l'app sta dietro un reverse proxy HTTPS (Nginx Proxy Manager, Traefik, Caddy...)
TRUST_PROXY=false
