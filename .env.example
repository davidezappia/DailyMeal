# Motore AI: "anthropic" (Claude, default) oppure "llamacpp" (llama-server nella tua rete)
AI_PROVIDER=anthropic

# --- Claude: chiave API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- llama.cpp: indirizzo di llama-server (API compatibile OpenAI)
# LLAMACPP_URL=http://192.168.1.50:8080
# Tempo massimo per una singola risposta del modello locale, in minuti
# LLAMACPP_TIMEOUT_MIN=30

# Registrazione aperta: il primo utente può sempre registrarsi.
# Metti true per creare gli altri account (es. tua moglie), poi rimetti false.
ALLOW_SIGNUP=false

# true se l'app sta dietro un reverse proxy HTTPS (Nginx Proxy Manager, Traefik, Caddy...)
TRUST_PROXY=false
